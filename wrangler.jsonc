{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dopa-disc-60",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/actions"]
  },
  "kv_namespaces": [
    {
      "binding": "DOPA_KV",
      "id": "d0b8f834926449f08a9e8f32f46aa8e0"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dopa-disc",
      "database_id": "293f3e2d-93b7-4685-9761-6893809add47",
      "migrations_dir": "migrations"
    }
  ],
  "routes": [
    { "pattern": "discgame.mct-official.com", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  }
}
